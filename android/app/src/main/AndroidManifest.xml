<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Epic 3 — icon noi tren moi app. Nguoi dung phai tu bat trong Cai dat;
         khong co hop thoai xin nhanh nao cho quyen nay. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service giu phien chup song trong khi nguoi dung o app khac.
         Tu Android 14, loai `mediaProjection` phai khai bao RIENG, va phai
         nhac lai luc goi startForeground() — thieu la SecurityException. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Moi LOAI foreground service doi mot quyen RIENG. Khai bao loai trong
         <service> thoi la chua du — thieu quyen la SecurityException luc chay,
         khong phai loi luc build. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Thong bao thuong truc cua foreground service (Android 13+ moi can xin). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Epic 4 — CHI de tai goi mo hinh MOT LAN (AD-15). Sau do app chay offline
      hoan toan (D1), khong goi mang nua.

      D3 chot KHONG lam che do cloud: khong co anh nao, khong co chu nao da OCR,
      khong co gi cua nguoi dung roi khoi may. Chieu duy nhat la TAI VE.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="Manga Translator"
        android:icon="@android:drawable/ic_menu_view"
        android:theme="@style/Theme.AppCompat.DayNight">

        <!--
          AD-23 — BAT BUOC de backend GPU khoi tao duoc.
          Tu Android 12, app phai khai bao tuong minh moi duoc dlopen thu vien
          vendor, KE CA khi no da nam trong /vendor/etc/public.libraries.txt.
          required=false: may khong co OpenCL van cai duoc, va tu lui ve CPU.

          Luu y: khai bao nay chi lam GPU KHOI TAO duoc, KHONG bao dam no sinh
          dung. Tren Adreno 642L, GPU khoi tao thanh cong roi sinh ra rac (AD-2).
        -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />
        <uses-native-library android:name="libGLES_mali.so" android:required="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Story 2.8/2.9 — FR-033 xem/sua, FR-034 xac nhan muc tu de xuat. -->
        <activity
            android:name=".ui.GlossaryActivity"
            android:label="Từ điển riêng"
            android:exported="false" />
        <!--
          Story 3.2 — AD-21: CHU SO HUU DUY NHAT cua MediaProjection.

          HAI loai, khong phai mot. Tu Android 14, khoi dong foreground service
          loai `mediaProjection` khi CHUA co quyen chup se nem SecurityException:

            Starting FGS with type mediaProjection targetSDK=36 requires
            all of [FOREGROUND_SERVICE_MEDIA_PROJECTION]
            and any of [CAPTURE_VIDEO_OUTPUT, android:project_media]

          Ma thiet ke cua ta la icon noi hien TRUOC, xin quyen SAU (nguoi dung
          cham icon moi hoi). Nen service phai bat dau o loai `specialUse` —
          luc do no chi giu icon noi — roi NANG CAP sang `mediaProjection` ngay
          sau khi nguoi dung dong y.

          M52 chay Android 13 nen khong bao gio lo loi nay (AD-22).
        -->
        <service
            android:name=".service.CaptureService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Giu icon noi trong luc cho nguoi dung cap quyen chup man hinh" />
        </service>

        <!--
          Man hinh trong suot, chi song du lau de xin quyen chup.

          `taskAffinity=""` la thu quan trong nhat o day: no cho Activity nay
          chay trong task RIENG. Thieu no thi mo tu service se keo ca task cua
          app len truoc — man hinh nhay ve trang chu cua app roi moi hien hop
          thoai, nhin y nhu app tu bat len de theo doi man hinh.
        -->
        <activity
            android:name=".ui.ProjectionRequestActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          ⚠️ KHONG dat `noHistory="true"` cho Activity tren.

          `noHistory` ket thuc Activity ngay khi no roi khoi tien canh — ma hop
          thoai xin quyen cua he thong CHINH LA mot Activity khac day len. Nen
          Activity cua ta bi huy trong luc dang cho ket qua, va callback cua
          `registerForActivityResult` khong bao gio chay: nguoi dung bam "Start
          now" xong ma app khong nhan duoc gi, service khong khoi dong.

          Da tu gay ra loi nay mot lan khi them `taskAffinity`.
        -->

        <!-- Epic 4 — cai dat lan dau: giai thich quyen, tai goi mo hinh, xoa goi. -->
        <activity
            android:name=".ui.SetupActivity"
            android:label="Cài đặt lần đầu"
            android:exported="false" />

        <!-- Story 3.10 — huong dan su dung, mo tu icon con hinh quyen sach. -->
        <activity
            android:name=".ui.GuideActivity"
            android:label="Hướng dẫn sử dụng"
            android:exported="false" />

    </application>
</manifest>
